# --- Shared ---
# PostgreSQL connection string (used by api + worker).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apihealth?schema=public"
# Redis connection string (required for the BullMQ check queue; the api also
# uses it as an optional 30s cache for the public status pages).
REDIS_URL="redis://localhost:6379"

# --- API (apps/api) ---
PORT=3001
# Management API key, sent as `x-api-key`. The seed script prints the value it used.
ADMIN_API_KEY="change-me-to-a-long-random-string"
# Consecutive failed checks before an incident is opened (default 2).
INCIDENT_THRESHOLD=2
# Where the demo target runs (used by the seed script).
DEMO_TARGET_URL="http://localhost:4000"

# --- Dashboard (apps/web) ---
# Server-side only: how the Next.js app reaches the API.
API_URL="http://localhost:3001"
# Server-side only: same value as ADMIN_API_KEY.
API_KEY="change-me-to-a-long-random-string"
